# Copy this file to .env.local and fill in the values. Never commit .env.local.
# To keep the hosted project in .env.local and still use the local stack,
# put the local values in .env.test.local too and run `npm run dev:local`.
#
# Local Supabase (npx supabase start): use the API URL and publishable key
# printed by `npx supabase status`.
# Hosted Supabase: Dashboard > Project Settings > API Keys / Data API.

# Supabase project URL, e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser;
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The sign-in cookie, set the same as the portal's. Leave both empty to keep
# finances' own sign-in on this host. With the domain both apps are under,
# like sbcsouthyouth.com, finances shares the portal's sign-in: people sign
# in, reset passwords, and set up accounts on the portal, and switch apps
# from the navigation. The name then defaults to sbc-auth. Leave it empty on
# Vercel previews. Locally, use sbc.localhost, with finances at
# http://finances.sbc.localhost:3000 and the portal below.
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# The leader portal, for signing in and the app switcher. Defaults to the
# real portal; set http://portal.localhost:3001 to use the local one, or
# http://portal.sbc.localhost:3001 with the shared sign-in.
PORTAL_URL=

# This app's own address, where the portal sends people back after they sign
# in there. It must match the portal's FINANCES_URL. Defaults to the real
# finances app; set http://finances.sbc.localhost:3000 with the shared
# sign-in locally.
FINANCES_URL=

# Do NOT put the service role / secret key or the database password in this app.
