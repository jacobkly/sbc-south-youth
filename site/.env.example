# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The portal uses all of these. The public site reads heads-ups and events
# and saves form messages, on the server, with the URL and secret key.
# Without them the site still builds, with empty heads-ups, no one-off
# events, and forms that point people to the email instead.
#
# Local Supabase (npx supabase start): use the API URL and publishable key
# printed by `npx supabase status`.
# Hosted Supabase: Dashboard > Project Settings > API Keys / Data API.

# Supabase project URL, e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser;
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The sign-in cookie. Leave both empty to keep it on the portal's own host
# with Supabase's default name.
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Which copy of the portal this is: production or staging. Staging shares
# production's data, so it shows a banner and refuses to save. Leave it
# empty to use production, except on Vercel previews, which use staging.
APP_ENV=

# Where the portal links for reimbursements. Defaults to the real finances
# app; set http://localhost:3000 to use the local one.
FINANCES_URL=

# Where invite emails send people to set up the portal. Defaults to the real
# portal; set http://portal.localhost:3001 to use the local one.
PORTAL_URL=

# Secret key (sb_secret_...), for the server only. It reads the site's
# heads-ups and events, saves form messages, logs and records email, and
# creates invited accounts. Never put it, or the database password, in a NEXT_PUBLIC_
# variable. Local: `npx supabase status`.
SUPABASE_SECRET_KEY=

# Email through Resend. Leave RESEND_API_KEY or EMAIL_FROM empty to turn
# email off: nothing is logged or sent.
# An API key with sending access only (re_...).
RESEND_API_KEY=
# The sender, on the domain verified in Resend, e.g.
# SBC South Youth <hello@mail.example.com>
EMAIL_FROM=
# Gets owner alerts. On staging, every email goes here instead, with the
# real recipient in the subject. Staging sends nothing without it.
OWNER_ALERT_EMAIL=
# The webhook's signing secret (whsec_...), from Resend > Webhooks. Point the
# webhook at https://<portal host>/api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# The secret the database sends when it asks the portal to send queued email,
# at least 16 characters. It must match the email_drain_secret in Supabase
# Vault. Local: the one in supabase/seed.sql.
EMAIL_DRAIN_SECRET=

# For local testing: send email to the local Supabase inbox instead of Resend
# (http://127.0.0.1:54324, the one `npx supabase status` lists). It only takes
# an address on this computer, and needs EMAIL_FROM. Leave it empty elsewhere.
EMAIL_LOCAL_INBOX=

# The message forms (Visit, Join, Serve, Contact). Without the Turnstile
# secret and the salt they show a "not taking messages" note with the email.
# Cloudflare Turnstile, from Cloudflare > Turnstile, for the public hosts.
# Locally and on previews, Cloudflare's test keys work: site key
# 1x00000000000000000000AA and secret 1x0000000000000000000000000000000AA.
# Production refuses the test secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Keys the hash of each sender's address for the hourly limit, so the
# address itself is never stored. At least 32 random characters, e.g.
# `openssl rand -hex 32`. Changing it restarts the count.
FORM_IP_SALT=
# Where a form message's email goes, with Reply-To set to the sender. On
# staging, OWNER_ALERT_EMAIL gets them instead. Needs email turned on.
YOUTH_INBOX_EMAIL=
