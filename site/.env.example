# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Only the portal uses these. The public site never talks to Supabase.
#
# Local Supabase (npx supabase start): use the API URL and publishable key
# printed by `npx supabase status`.
# Hosted Supabase: Dashboard > Project Settings > API Keys / Data API.

# Supabase project URL, e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser;
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The sign-in cookie. Leave both empty to keep it on the portal's own host
# with Supabase's default name.
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Which copy of the portal this is: production or staging. Staging shares
# production's data, so it shows a banner and refuses to save. Leave it
# empty to use production, except on Vercel previews, which use staging.
APP_ENV=

# Where the portal links for reimbursements. Defaults to the real finances
# app; set http://localhost:3000 to use the local one.
FINANCES_URL=

# Do NOT put the service role / secret key or the database password in a
# NEXT_PUBLIC_ variable.
