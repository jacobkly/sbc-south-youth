# Copy this file to .env.local and fill in the values. Never commit .env.local.
# To keep the hosted project in .env.local and still use the local stack,
# put the local values in .env.test.local too and run `npm run dev:local`.
# The portal uses all of these. The public site reads heads-ups and events
# and saves form messages, on the server, with the URL and secret key.
# Without them the site still builds, with empty heads-ups, no one-off
# events, and forms that point people to the email instead.
#
# Local Supabase (npx supabase start): use the API URL and publishable key
# printed by `npx supabase status`.
# Hosted Supabase: Dashboard > Project Settings > API Keys / Data API.

# Supabase project URL, e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser;
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The sign-in cookie. Leave both empty to keep it on the portal's own host
# with Supabase's default name, so the portal and finances each have their
# own sign-in. Set the domain both apps are under, like sbcsouthyouth.com,
# the same in both apps, to share one sign-in: everyone signs in on the
# portal, picks where to go, and switches apps from the navigation. The name
# then defaults to sbc-auth. Leave it empty on Vercel previews, so staging
# keeps its own sign-in. Locally, use sbc.localhost, with the portal at
# http://portal.sbc.localhost:3001 and finances at
# http://finances.sbc.localhost:3000 in the two URLs below.
NEXT_PUBLIC_AUTH_COOKIE_NAME=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Which copy of the portal this is: production or staging. Staging shares
# production's data, so it shows a banner and refuses to save. Leave it
# empty to use production, except on Vercel previews, which use staging.
APP_ENV=

# Where the portal links for reimbursements, and, with a shared sign-in, the
# one other place signing in may send someone back to. Defaults to the real
# finances app; set http://localhost:3000 to use the local one.
FINANCES_URL=

# Where invite emails send people to set up the portal. Defaults to the real
# portal; set http://portal.localhost:3001 to use the local one.
PORTAL_URL=

# Secret key (sb_secret_...), for the server only. It reads the site's
# heads-ups and events, saves form messages, logs and records email, and
# creates invited accounts. Never put it, or the database password, in a NEXT_PUBLIC_
# variable. Local: `npx supabase status`.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email, through Resend (resend.com)
#
# Until RESEND_API_KEY and EMAIL_FROM are both set, email is off: nothing is
# logged or sent, and everything else still works. To turn it on:
#   1. In Resend, add a sending domain (a subdomain like mail.<your domain>)
#      and copy the DNS records it lists into your DNS. Wait until Resend
#      shows it as verified, and turn off click and open tracking.
#   2. Fill in the five variables below. On Vercel, add them to the site
#      project for Production and Preview.
#   3. In the hosted Supabase project's Vault, add two secrets:
#        email_drain_url     https://<portal host>/api/email/drain
#        email_drain_secret  the same value as EMAIL_DRAIN_SECRET
#      The database uses them to ask the portal to send what it queued.
#
# Sign-in, setup, and password codes don't use these. Supabase sends them
# itself, so also enter Resend's SMTP details in Supabase's Auth SMTP settings.
# ---------------------------------------------------------------------------

# Resend > API Keys: create one with "Sending access" only, limited to your
# domain. Starts with re_.
RESEND_API_KEY=
# Who the emails come from: an address on the verified domain, with or
# without a name, e.g. SBC South Youth <hello@mail.example.com>
EMAIL_FROM=
# Resend > Webhooks: add an endpoint at https://<portal host>/api/webhooks/resend
# with the events email.sent, email.delivered, email.failed, email.bounced,
# email.complained, and email.suppressed, then copy its signing secret here.
# Starts with whsec_. It records deliveries and stops emailing addresses that
# bounce or complain.
RESEND_WEBHOOK_SECRET=
# Any long random string, at least 16 characters, e.g. `openssl rand -hex 32`.
# It must match email_drain_secret in Vault. Local: the one in supabase/seed.sql.
EMAIL_DRAIN_SECRET=
# Staging only (Vercel previews). Staging shares production's data, so every
# email it sends, form alerts included, goes to this one address instead,
# with the real recipient in the subject. Without it, staging sends nothing.
# Production ignores it: owner alerts go to each owner's own sign-in email.
OWNER_ALERT_EMAIL=

# For local testing: send email to the local Supabase inbox instead of Resend
# (http://127.0.0.1:54324, the one `npx supabase status` lists). It only takes
# an address on this computer, and needs EMAIL_FROM. Leave it empty elsewhere.
EMAIL_LOCAL_INBOX=

# The message forms (Visit, Join, Serve, Contact). Without the Turnstile
# secret and the salt they show a "not taking messages" note with the email.
# Cloudflare Turnstile, from Cloudflare > Turnstile, for the public hosts.
# Locally and on previews, Cloudflare's test keys work: site key
# 1x00000000000000000000AA and secret 1x0000000000000000000000000000000AA.
# Production refuses the test secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Keys the hash of each sender's address for the hourly limit, so the
# address itself is never stored. At least 32 random characters, e.g.
# `openssl rand -hex 32`. Changing it restarts the count.
FORM_IP_SALT=
# Where a form message's email goes, with Reply-To set to the sender. On
# staging, OWNER_ALERT_EMAIL gets them instead. Needs email turned on.
YOUTH_INBOX_EMAIL=
